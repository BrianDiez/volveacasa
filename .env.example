# Copiá este archivo a `.env` sólo si querés apuntar a OTRO proyecto de
# Supabase. Sin `.env`, la app usa el respaldo de src/lib/respaldo-publico.js,
# que es el proyecto de producción `volveacasa` (no hay staging: BRIEF §10.4).

# Públicas: viajan en el JavaScript del navegador.
VITE_SUPABASE_URL=https://blyyywzroyydnusqpzfq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Sólo servidor (/api). NUNCA con prefijo VITE_: saltea la RLS.
SUPABASE_SERVICE_ROLE_KEY=
